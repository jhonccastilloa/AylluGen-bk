generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/database/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  dni               String             @unique
  password          String
  refreshToken      RefreshToken[]
  animals           Animal[]
  breedings         Breeding[]
  healthRecords     HealthRecord[]
  productionRecords ProductionRecord[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Animal {
  id                String             @id @default(uuid())
  crotal            String
  sex               Sex
  species           Species
  birthDate         DateTime?
  isFounder         Boolean            @default(false)
  fatherId          String?
  motherId          String?
  father            Animal?            @relation("FatherChildren", fields: [fatherId], references: [id], onDelete: SetNull)
  mother            Animal?            @relation("MotherChildren", fields: [motherId], references: [id], onDelete: SetNull)
  fatherOf          Animal[]           @relation("FatherChildren")
  motherOf          Animal[]           @relation("MotherChildren")
  breedings         Breeding[]
  healthRecords     HealthRecord[]
  productionRecords ProductionRecord[]
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncStatus        SyncStatus         @default(SYNCED)
  syncVersion       Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@unique([userId, crotal])
  @@index([userId])
  @@map("animals")
}

model Breeding {
  id           String     @id @default(uuid())
  maleId       String
  femaleId     String
  projectedCOI Float
  riskLevel    RiskLevel
  offspringId  String?
  offspring    Animal?    @relation(fields: [offspringId], references: [id], onDelete: SetNull)
  breedingDate DateTime?
  notes        String?
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncStatus   SyncStatus @default(SYNCED)
  syncVersion  Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
  @@index([maleId])
  @@index([femaleId])
  @@map("breedings")
}

model HealthRecord {
  id          String     @id @default(uuid())
  animalId    String
  animal      Animal     @relation(fields: [animalId], references: [id], onDelete: Cascade)
  type        HealthType
  date        DateTime
  notes       String?
  nextDueDate DateTime?
  completed   Boolean    @default(true)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncStatus  SyncStatus @default(SYNCED)
  syncVersion Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([animalId])
  @@index([type])
  @@index([date])
  @@map("health_records")
}

model ProductionRecord {
  id           String         @id @default(uuid())
  animalId     String
  animal       Animal         @relation(fields: [animalId], references: [id], onDelete: Cascade)
  type         ProductionType
  date         DateTime
  value        Float
  unit         String
  qualityScore Int?
  notes        String?
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncStatus   SyncStatus     @default(SYNCED)
  syncVersion  Int            @default(1)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([animalId])
  @@index([type])
  @@index([date])
  @@map("production_records")
}

model SyncLog {
  id        String     @id @default(uuid())
  userId    String
  action    SyncAction
  tableName String
  recordId  String
  data      Json
  status    SyncStatus @default(PENDING)
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([status])
  @@map("sync_logs")
}

enum Sex {
  MALE
  FEMALE
}

enum Species {
  SHEEP
  ALPACA
  LLAMA
  VICUGNA
}

enum RiskLevel {
  GREEN
  YELLOW
  RED
}

enum HealthType {
  VACCINATION
  DEWORMING
  SHEARING
  CHECKUP
  TREATMENT
}

enum ProductionType {
  WEIGHT
  WOOL
  FIBER
  MEAT
  MILK
}

enum SyncStatus {
  SYNCED
  PENDING
  CONFLICT
  DELETED
}

enum SyncAction {
  CREATE
  UPDATE
  DELETE
}
